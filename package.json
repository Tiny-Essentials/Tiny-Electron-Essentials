{
  "name": "tiny-electron-essentials",
  "description": "A lightweight and modular utility library for Electron apps, offering simplified window management, tray support, IPC channels, and custom frameless window styling.",
  "version": "1.1.0",
  "scripts": {
    "test": "electronmon ./test/main.mjs",
    "fix:prettier": "npm run fix:prettier:src && npm run fix:prettier:test && npm run fix:prettier:rollup.config",
    "fix:prettier:src": "prettier --write ./src/*",
    "fix:prettier:test": "prettier --write ./test/*",
    "fix:prettier:rollup.config": "prettier --write ./rollup.config.mjs",
    "auto-build": "npm run build",
    "build": "npm run build:js",
    "build:js": "tsc -p tsconfig.json && rollup -c && node ./build/index.mjs",
    "build-clean": "npm run clean && npm run build",
    "build-dist": "npm run build",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.mts",
  "ethereum": "jasmindreasond.x",
  "exports": {
    ".": {
      "require": "./index.cjs",
      "import": "./index.mjs"
    },
    "./preload": {
      "require": "./preload/index.cjs",
      "import": "./preload/index.mjs"
    },
    "./preload/LoadingHtml": {
      "require": "./preload/LoadingHtml.cjs",
      "import": "./preload/LoadingHtml.mjs"
    },
    "./preload/TinyDb": {
      "require": "./preload/TinyDb.cjs",
      "import": "./preload/TinyDb.mjs"
    },
    "./preload/TinyElectronClient": {
      "require": "./preload/TinyElectronClient.cjs",
      "import": "./preload/TinyElectronClient.mjs"
    },
    "./preload/TinyElectronNotification": {
      "require": "./preload/TinyElectronNotification.cjs",
      "import": "./preload/TinyElectronNotification.mjs"
    },
    "./preload/TinyWindowFrameManager": {
      "require": "./preload/TinyWindowFrameManager.cjs",
      "import": "./preload/TinyWindowFrameManager.mjs"
    },
    "./main": {
      "require": "./main/index.cjs",
      "import": "./main/index.mjs"
    },
    "./main/TinyDb": {
      "require": "./main/TinyDb.cjs",
      "import": "./main/TinyDb.mjs"
    },
    "./main/TinyElectronNotification": {
      "require": "./main/TinyElectronNotification.cjs",
      "import": "./main/TinyElectronNotification.mjs"
    },
    "./main/TinyElectronRoot": {
      "require": "./main/TinyElectronRoot.cjs",
      "import": "./main/TinyElectronRoot.mjs"
    },
    "./main/TinyWindowFile": {
      "require": "./main/TinyWindowFile.cjs",
      "import": "./main/TinyWindowFile.mjs"
    },
    "./main/TinyWinInstance": {
      "require": "./main/TinyWinInstance.cjs",
      "import": "./main/TinyWinInstance.mjs"
    },
    "./global": {
      "require": "./global/index.cjs",
      "import": "./global/index.mjs"
    },
    "./global/CssFile": {
      "require": "./global/CssFile.cjs",
      "import": "./global/CssFile.mjs"
    },
    "./global/Events": {
      "require": "./global/Events.cjs",
      "import": "./global/Events.mjs"
    },
    "./global/Utils": {
      "require": "./global/Utils.cjs",
      "import": "./global/Utils.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tiny-Essentials/Tiny-Electron-Essentials.git"
  },
  "keywords": [
    "electron",
    "electron-app",
    "electron-utils",
    "electron-ipc",
    "electron-window",
    "frameless-window",
    "custom-titlebar",
    "electron-tray",
    "electron-notification",
    "electron-helper",
    "electron-toolkit",
    "electron-framework",
    "window-manager",
    "desktop-app",
    "tiny-electron"
  ],
  "author": "Yasmin Seidel (Jasmin Dreasond)",
  "license": "LGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/Tiny-Essentials/Tiny-Electron-Essentials/issues"
  },
  "homepage": "https://github.com/Tiny-Essentials/Tiny-Electron-Essentials#readme",
  "devDependencies": {
    "@babel/cli": "^8.0.1",
    "@babel/core": "^8.0.1",
    "@babel/node": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/register": "^8.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/tinycolor2": "^1.4.6",
    "babel-preset-es2015": "^6.24.1",
    "electron": "^43.2.0",
    "electronmon": "^2.0.4",
    "mime-types": "^3.0.1",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "prettier": "^3.9.4",
    "rollup": "^4.62.2",
    "rollup-preserve-directives": "^1.1.3",
    "tslib": "^2.8.1",
    "type-fest": "^4.40.0",
    "typescript": "^6.0.3",
    "webpack": "^5.99.6",
    "webpack-cli": "^6.0.1"
  }
}
